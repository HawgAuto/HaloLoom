#!/usr/bin/env bash
set -euo pipefail

export HOME="${HOME:-/home/haloloom}"
if [[ -f /workspace/.env ]]; then
  set -a
  # shellcheck disable=SC1091
  source /workspace/.env
  set +a
fi

export USER_DATA_PATH="${USER_DATA_PATH:-/workspace}"
export HYPERLOOM_RUNTIME_DIR="${HYPERLOOM_RUNTIME_DIR:-${USER_DATA_PATH}/runtime}"
export KERNEL_AGENT_ENV="${KERNEL_AGENT_ENV:-${HYPERLOOM_RUNTIME_DIR}/kernel-agent.env.sh}"
export HYPERLOOM_CACHE_DIR=/opt/haloloom/components
export HYPERLOOM_DEPS_ROOT=/opt/haloloom/components
export HYPERLOOM_ROOT=/opt/haloloom/components/Hyperloom
export HYPERLOOM_KERNEL_AGENT_ROOT=/opt/haloloom/components/Hyperloom/src/hyperloom/agents/kernel
export KERNEL_AGENT_ROOT="$HYPERLOOM_KERNEL_AGENT_ROOT"
export FRAMEWORK_AGENT_ROOT=/opt/haloloom/components/Hyperloom/src/hyperloom/agents/framework
export MAGPIE_PATH=/opt/haloloom/components/Magpie
export MAGPIE_PYTHON=/opt/venv/bin/python3
export INFERENCEX_PATH=/opt/haloloom/components/InferenceX
export TRACELENS_ROOT=/opt/haloloom/components/TraceLens
export GEAK_ROOT=/opt/haloloom/components/GEAK
export GEAK_E2E_RUNNER=/opt/haloloom/components/GEAK/interface/run_e2e.py
export INFERENCE_OPTIMIZER_FRAMEWORK_SOURCE_ROOTS=/opt/haloloom/framework-source/vllm:/opt/haloloom/framework-source/sglang
export HALOLOOM_AGENT_BIN_DIR="${HALOLOOM_AGENT_BIN_DIR:-/opt/haloloom/agent-bin}"
export PYTHONPATH="/opt/haloloom/components/Magpie:${PYTHONPATH:-}"
export PATH="/opt/venv/bin:${HALOLOOM_AGENT_BIN_DIR}:/usr/local/bin:${PATH:-/usr/bin:/bin}"
unset HSA_OVERRIDE_GFX_VERSION 2>/dev/null || true

case "${1:-}" in
  verify)
    shift
    exec /opt/venv/bin/python3 /opt/haloloom/verify_ecosystem.py "$@"
    ;;
  readiness)
    shift
    if [[ "${1:-}" == status && ! -f "$USER_DATA_PATH/readiness-control/READINESS-EPOCH.json" ]]; then
      echo "HaloLoom readiness epoch is not initialized in this workspace yet." >&2
      echo "Run:  ./scripts/haloloom ${FRAMEWORK:-vllm} readiness initialize" >&2
      exit 2
    fi
    exec /opt/venv/bin/python3 -m hyperloom.orchestrator.production_readiness \
      --root "$USER_DATA_PATH/readiness-control" \
      --registry /opt/haloloom/components/Hyperloom/src/hyperloom/orchestrator/kernel-targets-gfx1151-v1.json \
      --vllm-root /opt/haloloom/framework-source/vllm \
      --sglang-root /opt/haloloom/framework-source/sglang \
      --providers /opt/haloloom/components/Hyperloom/src/hyperloom/orchestrator/production-providers-gfx1151-v1.json \
      --functional-proof /opt/haloloom/readiness/FUNCTIONAL-TARGET-MATRIX.json \
      "$@"
    ;;
  ""|help|--help|-h)
    exec /opt/venv/bin/inference_optimizer --help
    ;;
esac

agent="${HALOLOOM_AGENT_PROFILE:-}"
case "$agent" in
  claude)
    agent_bin="${HALOLOOM_CLAUDE_BIN_HOST:-}"
    export GEAK_CLAUDE_BIN="$agent_bin"
    ;;
  codex)
    agent_bin="${HALOLOOM_CODEX_BIN_HOST:-}"
    export INFERENCE_OPTIMIZER_CODEX_BIN="${INFERENCE_OPTIMIZER_CODEX_BIN:-$agent_bin}"
    export GEAK_CODEX_BIN="$agent_bin"
    # Forge's native hooks protect driver/oracle files inside each lane. Keep
    # an explicit operator choice (the adapter rejects bypass with hooks), but
    # do not default Forge to the broader authoring role's outer-only boundary.
    export FORGE_AGENT_SANDBOX_MODE="${FORGE_AGENT_SANDBOX_MODE:-workspace-write}"
    # Subscription users: the host `codex login` is mounted read-only at
    # $CODEX_HOME. When it exists and the operator set no API key/gateway URL,
    # opt the Orchestrator's Codex role into Hyperloom's native_oauth mode (the
    # same contract KernelForge's Codex backend uses). An explicit key always
    # wins and keeps upstream gateway semantics untouched.
    if [[ -f "$CODEX_HOME/auth.json" && -z "${OPENAI_API_KEY:-}${OPENAI_BASE_URL:-}" ]]; then
      native_home=/tmp/haloloom-codex-home
      rm -rf "$native_home"
      install -d -m 0700 "$native_home"
      install -m 0600 "$CODEX_HOME/auth.json" "$native_home/auth.json"
      export INFERENCE_OPTIMIZER_CODEX_AUTH_MODE=native_oauth
      export INFERENCE_OPTIMIZER_CODEX_HOME="$native_home"
      export GEAK_CODEX_HOME="$native_home"
      # Forge has a separate transport-options contract. Carry the selected
      # native login without replacing explicit per-Forge transport settings.
      FORGE_AGENT_OPTIONS_JSON="$(python3 - "$native_home" <<'PY'
import json, os, sys
options = json.loads(os.environ.get("FORGE_AGENT_OPTIONS_JSON") or "{}")
if not isinstance(options, dict):
    raise SystemExit("FORGE_AGENT_OPTIONS_JSON must be a JSON object")
if "auth_mode" not in options and not options.get("gateway"):
    options["auth_mode"] = "native_oauth"
if options.get("auth_mode") == "native_oauth":
    options.setdefault("home", sys.argv[1])
print(json.dumps(options))
PY
)"
      export FORGE_AGENT_OPTIONS_JSON
      export FORGE_AGENT_FALLBACK_PROVIDER="${FORGE_AGENT_FALLBACK_PROVIDER:-none}"
      export FORGE_AGENT_FALLBACK_MODEL="${FORGE_AGENT_FALLBACK_MODEL:-off}"
      # Kernel authoring uses the outer container boundary. Roles that pin
      # workspace-write (such as candidate review) retain that restriction and
      # require the opt-in native sandbox policy; never downgrade those roles.
      export HYPERLOOM_CODEX_EXTERNAL_SANDBOX=1
      export HYPERLOOM_CODEX_SANDBOX_MODE=bypass
      export GEAK_CODEX_EXTERNAL_SANDBOX=1
    fi
    ;;
  hermes)
    agent_bin="${HALOLOOM_HERMES_BIN_HOST:-}"
    export GEAK_HERMES_BIN="$agent_bin"
    export HYPERLOOM_HERMES_BIN="$agent_bin"
    export HYPERLOOM_HERMES_EXTERNAL_SANDBOX=1
    export GEAK_HERMES_EXTERNAL_SANDBOX=1
    ;;
  *)
    echo "HaloLoom agent plug-in is not selected; rerun ./scripts/install.sh --agent auto." >&2
    exit 1
    ;;
esac
if [[ ! -x "$agent_bin" ]]; then
  echo "Selected $agent agent CLI is not executable inside the container: $agent_bin" >&2
  echo "Rerun ./scripts/install.sh --agent $agent after checking the host CLI." >&2
  exit 1
fi
export PATH="$(dirname "$agent_bin"):$PATH"
export GEAK_AGENT_PROFILE="$agent"
export FORGE_AGENT_BACKEND="$agent"
export FORGE_AGENT_CLI="$agent_bin"

if [[ "${1:-}" == agent-check ]]; then
  shift
  exec "$agent_bin" --version "$@"
fi

mkdir -p \
  "$HYPERLOOM_RUNTIME_DIR" "$USER_DATA_PATH/optimizer_runs" \
  "$XDG_CACHE_HOME" "$VLLM_CACHE_ROOT" "$VLLM_CONFIG_ROOT" \
  "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

# Hyperloom's preflight re-reads this file through a strict allowlist
# (hyperloom.common.env_safety.KERNEL_AGENT_ENV_EXACT_ALLOWLIST) and warns on
# every key it rejects, so write only allowlisted keys here. Everything else
# (PATH, PYTHONPATH, agent profile/bin selection, component roots) is already
# exported into the process environment above. No credentials are written.
tmp="${KERNEL_AGENT_ENV}.tmp.$$"
{
  printf '%s\n' '#!/usr/bin/env bash'
  for name in \
    USER_DATA_PATH HYPERLOOM_RUNTIME_DIR HYPERLOOM_ROOT HYPERLOOM_KERNEL_AGENT_ROOT \
    KERNEL_AGENT_ROOT MAGPIE_PATH MAGPIE_PYTHON \
    INFERENCEX_PATH TRACELENS_ROOT GEAK_ROOT GEAK_E2E_RUNNER \
    INFERENCE_OPTIMIZER_FRAMEWORK_SOURCE_ROOTS; do
    printf 'export %s=%q\n' "$name" "${!name}"
  done
  if [[ "$agent" == claude ]]; then
    printf 'export GEAK_CLAUDE_BIN=%q\n' "$GEAK_CLAUDE_BIN"
  fi
} > "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$KERNEL_AGENT_ENV"

if [[ "${1:-}" == shell ]]; then
  shift
  exec /bin/bash "$@"
fi

# One outer lease covers the optimizer driver and every child it launches.
# GEAK's own per-lane locks use separate sentinels and do not re-lock this file.
exec flock -x /run/lock/hermes-vllm-gfx1151.lock \
  /opt/venv/bin/inference_optimizer "$@"
